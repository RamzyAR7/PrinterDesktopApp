        private void SaveInvoice(bool closeAfter, bool preview = false, bool print = false)
        {
            // Enhanced validation and save logic (parity with InvoiceCUForm)
            if (invoiceItems.Count == 0)
            {
                XtraMessageBox.Show("يجب إضافة منتجات للفاتورة", "تنبيه", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            if (string.IsNullOrWhiteSpace(txtCustomerName.Text))
            {
                XtraMessageBox.Show("يرجى إدخال اسم العميل", "تنبيه", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            decimal discount = 0;
            decimal.TryParse(textEdit3.Text, out discount);
            decimal total = invoiceItems.Sum(i => i.UnitPrice * i.Quantity);
            decimal net = total - discount;
            if (!isEditMode)
            {
                var invoice = new Invoice
                {
                    InvoiceNumber = txtInvoiceNumber.Text,
                    InvoiceDate = (DateTime)dtInvoiceDate.EditValue,
                    CustomerName = txtCustomerName.Text,
                    CustomerPhone = txtCustomerPhone.Text,
                    Discount = discount,
                    TotalAmount = total,
                    NetAmount = net,
                    InvoiceItems = invoiceItems.Select(i => new InvoiceItem
                    {
                        ProductName = i.ProductName,
                        UnitPrice = i.UnitPrice,
                        Quantity = i.Quantity
                    }).ToList()
                };
                dbContext.Invoices.Add(invoice);
            }
            else if (currentInvoice != null)
            {
                currentInvoice.InvoiceDate = (DateTime)dtInvoiceDate.EditValue;
                currentInvoice.CustomerName = txtCustomerName.Text;
                currentInvoice.CustomerPhone = txtCustomerPhone.Text;
                currentInvoice.Discount = discount;
                currentInvoice.TotalAmount = total;
                currentInvoice.NetAmount = net;
                // Remove and re-add items for full update
                var existingItems = dbContext.InvoiceItems.Where(i => i.InvoiceId == currentInvoice.Id).ToList();
                foreach (var item in existingItems)
                    dbContext.InvoiceItems.Remove(item);
                foreach (var i in invoiceItems)
                {
                    dbContext.InvoiceItems.Add(new InvoiceItem
                    {
                        InvoiceId = currentInvoice.Id,
                        ProductName = i.ProductName,
                        UnitPrice = i.UnitPrice,
                        Quantity = i.Quantity
                    });
                }
            }
            dbContext.SaveChanges();
            InvoiceSaved = true;
            if (closeAfter)
                this.Close();
            // TODO: implement preview/print logic if needed
        }

        public void LoadInvoiceForEdit(int invoiceId)
        {
            isEditMode = true;
            currentInvoice = dbContext.Invoices.Include("InvoiceItems").FirstOrDefault(i => i.Id == invoiceId);
            if (currentInvoice != null)
            {
                txtInvoiceNumber.Text = currentInvoice.InvoiceNumber;
                dtInvoiceDate.EditValue = currentInvoice.InvoiceDate;
                txtCustomerName.Text = currentInvoice.CustomerName;
                txtCustomerPhone.Text = currentInvoice.CustomerPhone;
                var culture = new System.Globalization.CultureInfo("ar-EG");
                textEdit3.Text = currentInvoice.Discount > 0 ? string.Format(culture, "{0:N0}", currentInvoice.Discount) : "";
                invoiceItems = currentInvoice.InvoiceItems.Select(item => new InvoiceItem
                {
                    ProductName = item.ProductName,
                    UnitPrice = item.UnitPrice,
                    Quantity = item.Quantity
                }).ToList();
                RefreshInvoiceGrid();
                AdjustEditSaveButtons();
            }
            else
            {
                if (EditBtn != null) EditBtn.Visible = false;
                if (NewBtn != null) NewBtn.Visible = true;
            }
        }

        private void GridView2_DoubleClick(object sender, EventArgs e)
        {
            var view = sender as DevExpress.XtraGrid.Views.Grid.GridView;
            if (view == null) return;
            var hitInfo = view.CalcHitInfo(view.GridControl.PointToClient(Control.MousePosition));
            if (hitInfo.InRow && hitInfo.RowHandle >= 0)
            {
                int rowHandle = hitInfo.RowHandle;
                if (rowHandle >= 0 && rowHandle < invoiceItems.Count)
                {
                    var result = XtraMessageBox.Show($"هل تريد حذف المنتج '{invoiceItems[rowHandle].ProductName}' من الفاتورة؟", "تأكيد الحذف", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
                    if (result == DialogResult.Yes)
                    {
                        invoiceItems.RemoveAt(rowHandle);
                        RefreshInvoiceGrid();
                    }
                }
            }
    }


