        private void CalculateTotals()
        {
            decimal total = invoiceItems.Sum(i => i.UnitPrice * i.Quantity);
            decimal discount = 0;
            decimal.TryParse(textEdit3.Text, out discount); // textEdit3 = discount
            decimal net = total - discount;
            var culture = new System.Globalization.CultureInfo("ar-EG");
            textEdit2.Text = total > 0 ? string.Format(culture, "{0:N0}", total) : ""; // المجموع
            textEdit3.Text = discount > 0 ? string.Format(culture, "{0:N0}", discount) : ""; // الخصم
            textEdit4.Text = net > 0 ? string.Format(culture, "{0:N0}", net) : ""; // الاجمالى
    }

        private void GenerateInvoiceNumber()
        {
            string datePrefix = DateTime.Now.ToString("yyMMdd");
            var todayInvoices = dbContext.Invoices.Where(i => i.InvoiceNumber.StartsWith(datePrefix)).Count();
            int sequenceNumber = todayInvoices + 1;
            txtInvoiceNumber.Text = $"{datePrefix}0{sequenceNumber:D0}";
        }

