        private void ValidateNumericInput(TextEdit textEdit)
        {
            if (textEdit == null) return;

            string text = textEdit.Text;
            if (string.IsNullOrEmpty(text)) return;

            // Allow only numbers and decimal point
            if (!System.Text.RegularExpressions.Regex.IsMatch(text, @"^\d*\.?\d*$"))
            {
                // Remove the last character if it's not valid
                int selectionStart = textEdit.SelectionStart;
                textEdit.Text = text.Substring(0, text.Length - 1);
                textEdit.SelectionStart = Math.Max(0, selectionStart - 1);
                
                // Show brief validation feedback
                textEdit.BackColor = Color.FromArgb(255, 243, 205);
                textEdit.Properties.Appearance.BorderColor = Color.FromArgb(220, 53, 69);
            }
        }

