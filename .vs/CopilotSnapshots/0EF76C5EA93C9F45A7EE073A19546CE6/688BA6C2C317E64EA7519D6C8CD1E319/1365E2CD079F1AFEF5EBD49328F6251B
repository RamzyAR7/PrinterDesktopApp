        private void ValidateField(Control control, bool isValid)
        {
            if (control == null) return;
            
            if (isValid)
            {
                control.BackColor = Color.White;
                if (control is TextEdit textEdit)
                    textEdit.Properties.Appearance.BorderColor = Color.FromArgb(40, 167, 69);
                else if (control is LookUpEdit lookupEdit)
                    lookupEdit.Properties.Appearance.BorderColor = Color.FromArgb(40, 167, 69);
