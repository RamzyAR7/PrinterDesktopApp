        private void LoadProductForEdit(int productId)
        {
            try
            {
                currentProduct = dbContext.Products.FirstOrDefault(p => p.Id == productId);

                if (currentProduct != null)
                {
                    // Load product data with enhanced styling
                    txtProductName.Text = currentProduct.Name;
                    cmbCompany.EditValue = currentProduct.CompanyId;
                    cmbCategory.EditValue = currentProduct.CategoryId;
                    txtDescription.Text = currentProduct.Description;

                    // Load latest price
                    var latestPrice = dbContext.Prices
                        .Where(p => p.ProductId == productId)
                        .OrderByDescending(p => p.CreatedDate)
                        .FirstOrDefault();

                    if (latestPrice != null)
                    {
                        txtSellingPrice.Text = latestPrice.SellingPrice.ToString("0.00");
                        txtPurchasingPrice.Text = latestPrice.PurchasingPrice.ToString("0.00");
                    }
                    
                    // Validate all fields after loading
                    ValidateAllFields();
                }
            }
            catch (Exception ex)
            {
                ShowModernErrorMessage($"خطأ في تحميل بيانات المنتج: {ex.Message}");
            }
        }

        private void ValidateAllFields()
        {
            ValidateField(txtProductName, !string.IsNullOrWhiteSpace(txtProductName.Text));
            ValidateField(cmbCompany, cmbCompany.EditValue != null);
            ValidateField(cmbCategory, cmbCategory.EditValue != null);
            ValidateNumericField(txtSellingPrice);
            ValidateNumericField(txtPurchasingPrice);
        }

        private bool ValidateForm()
        {
            var errors = new List<string>();

            if (string.IsNullOrWhiteSpace(txtProductName.Text))
                errors.Add("يرجى إدخال اسم المنتج");

            if (cmbCompany.EditValue == null)
                errors.Add("يرجى اختيار الشركة");

            if (cmbCategory.EditValue == null)
                errors.Add("يرجى اختيار الصنف");

            // Validate selling price
            if (string.IsNullOrWhiteSpace(txtSellingPrice.Text))
            {
                errors.Add("يرجى إدخال سعر البيع");
            }
            else if (!decimal.TryParse(txtSellingPrice.Text, out decimal sellingPrice) || sellingPrice <= 0)
            {
                errors.Add("يرجى إدخال سعر بيع صحيح (أرقام فقط)");
            }

            // Validate purchasing price
            if (string.IsNullOrWhiteSpace(txtPurchasingPrice.Text))
            {
                errors.Add("يرجى إدخال سعر الشراء");
            }
            else if (!decimal.TryParse(txtPurchasingPrice.Text, out decimal purchasingPrice) || purchasingPrice <= 0)
            {
                errors.Add("يرجى إدخال سعر شراء صحيح (أرقام فقط)");
            }

            if (errors.Any())
            {
                ShowModernErrorMessage(string.Join("\n• ", errors.Prepend("يرجى تصحيح الأخطاء التالية:")));
                return false;
            }

            return true;
        }

        private Product SaveProduct()
        {
            if (currentProduct == null)
            {
                // Create new product
                var newProduct = new Product
                {
                    Name = txtProductName.Text.Trim(),
                    CompanyId = Convert.ToInt32(cmbCompany.EditValue),
                    CategoryId = Convert.ToInt32(cmbCategory.EditValue),
                    Description = txtDescription.Text?.Trim(),
                    CreatedDate = DateTime.Now
                };

                dbContext.Products.Add(newProduct);
                dbContext.SaveChanges();

                // Add price record
                var price = new Price
                {
                    ProductId = newProduct.Id,
                    SellingPrice = decimal.Parse(txtSellingPrice.Text),
                    PurchasingPrice = decimal.Parse(txtPurchasingPrice.Text),
                    CreatedDate = DateTime.Now,
                    IsActive = true
                };

                dbContext.Prices.Add(price);
                dbContext.SaveChanges();

                currentProduct = newProduct;
                return newProduct;
            }
            else
            {
                // Update existing product
                currentProduct.Name = txtProductName.Text.Trim();
                currentProduct.CompanyId = Convert.ToInt32(cmbCompany.EditValue);
                currentProduct.CategoryId = Convert.ToInt32(cmbCategory.EditValue);
                currentProduct.Description = txtDescription.Text?.Trim();

                // Deactivate old prices
                var oldPrices = dbContext.Prices.Where(p => p.ProductId == currentProduct.Id);
                foreach (var oldPrice in oldPrices)
                {
                    oldPrice.IsActive = false;
                }

                // Add new price record
                var newPrice = new Price
                {
                    ProductId = currentProduct.Id,
                    SellingPrice = decimal.Parse(txtSellingPrice.Text),
                    PurchasingPrice = decimal.Parse(txtPurchasingPrice.Text),
                    CreatedDate = DateTime.Now,
                    IsActive = true
                };

                dbContext.Prices.Add(newPrice);
                dbContext.SaveChanges();

                return currentProduct;
            }
        }

