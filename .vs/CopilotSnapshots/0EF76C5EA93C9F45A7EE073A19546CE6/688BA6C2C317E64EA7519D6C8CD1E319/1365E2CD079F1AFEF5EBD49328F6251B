        private void StyleModernButton(SimpleButton button, Color backColor, Color foreColor, string icon = "")
        {
            if (button == null) return;
            
            // Basic appearance
            button.Appearance.BackColor = backColor;
            button.Appearance.ForeColor = foreColor;
            button.Appearance.BorderColor = backColor;
            button.Appearance.Options.UseBackColor = true;
            button.Appearance.Options.UseForeColor = true;
            button.Appearance.Options.UseBorderColor = true;
            button.Appearance.Font = new Font("Tahoma", 11F, FontStyle.Bold);
            button.Appearance.Options.UseFont = true;
            
            // Modern rounded corners effect
            button.LookAndFeel.UseDefaultLookAndFeel = false;
            button.LookAndFeel.SkinName = "Office 2019 Colorful";
            
            // Add icon if provided
            if (!string.IsNullOrEmpty(icon))
            {
                button.Text = $"{icon} {button.Text}";
            }
            
            // Add hover effects
            button.MouseEnter += (s, e) => OnButtonHover(button, true);
            button.MouseLeave += (s, e) => OnButtonHover(button, false);
        }

        private void OnButtonHover(SimpleButton button, bool isHover)
        {
            if (button == null) return;
            
            if (isHover)
            {
                // Brighten button on hover
                var currentColor = button.Appearance.BackColor;
                var lighterColor = ControlPaint.Light(currentColor, 0.2f);
                button.Appearance.BackColor = lighterColor;
                button.Appearance.BorderColor = lighterColor;
            }
            else
            {
                // Restore original color
                if (button == BtnCreate || button == EditBtn)
                {
                    button.Appearance.BackColor = Color.FromArgb(0, 123, 255);
                    button.Appearance.BorderColor = Color.FromArgb(0, 123, 255);
                }
                else if (button == btnPreview)
                {
                    button.Appearance.BackColor = Color.FromArgb(23, 162, 184);
                    button.Appearance.BorderColor = Color.FromArgb(23, 162, 184);
                }
                else if (button == btnSaveAndPrint)
                {
                    button.Appearance.BackColor = Color.FromArgb(40, 167, 69);
                    button.Appearance.BorderColor = Color.FromArgb(40, 167, 69);
                }
                else if (button == btnCancel)
                {
                    button.Appearance.BackColor = Color.FromArgb(108, 117, 125);
                    button.Appearance.BorderColor = Color.FromArgb(108, 117, 125);
                }
            }
        }

