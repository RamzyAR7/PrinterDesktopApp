                    textEdit.Properties.Appearance.BorderColor = Color.FromArgb(255, 193, 7);
                else if (control is LookUpEdit lookupEdit)
                    lookupEdit.Properties.Appearance.BorderColor = Color.FromArgb(255, 193, 7);
            }
        }

        private void ValidateNumericField(TextEdit textEdit)
        {
