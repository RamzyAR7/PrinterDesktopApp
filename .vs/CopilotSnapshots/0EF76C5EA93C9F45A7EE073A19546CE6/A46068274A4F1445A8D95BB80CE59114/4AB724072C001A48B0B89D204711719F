        private void GridView2_CustomUnboundColumnData(object sender, DevExpress.XtraGrid.Views.Base.CustomColumnDataEventArgs e)
        {
            if (e.Column.FieldName == "Remove" && e.IsGetData)
                e.Value = "✕";
            if (e.Column.FieldName == "Total" && e.IsGetData && e.ListSourceRowIndex >= 0 && e.ListSourceRowIndex < invoiceItems.Count)
            {
                var item = invoiceItems[e.ListSourceRowIndex];
                e.Value = item.UnitPrice * item.Quantity;
            }
        }

        private void GridView2_Click(object sender, EventArgs e)
        {
            var view = sender as DevExpress.XtraGrid.Views.Grid.GridView;
            if (view == null) return;

            var hitInfo = view.CalcHitInfo(view.GridControl.PointToClient(Control.MousePosition));
            if (hitInfo.InRowCell && hitInfo.Column != null && hitInfo.Column.FieldName == "Remove")
            {
                int rowHandle = hitInfo.RowHandle;
                if (rowHandle >= 0 && rowHandle < invoiceItems.Count)
                {
                    var removed = invoiceItems[rowHandle];
                    var product = allProducts.FirstOrDefault(p => p.Name == removed.ProductName);
                    var result = XtraMessageBox.Show($"هل تريد حذف المنتج '{removed.ProductName}' من الفاتورة؟",
                        "تأكيد الحذف", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
                    if (result == DialogResult.Yes)
                    {
                        if (product != null && !filteredProducts.Any(p => p.Id == product.Id))
                            filteredProducts.Add(product);
                        invoiceItems.RemoveAt(rowHandle);
                        ApplyProductFilters(); // Ensure product grid is filtered after remove
                        RefreshProductGrid();
                        RefreshInvoiceGrid();
                        CalculateTotals();
                    }
                }
            }
        }

        private void GridView2_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.KeyCode == Keys.Delete)
            {
                int selectedRowHandle = gridView2.FocusedRowHandle;
                if (selectedRowHandle >= 0 && selectedRowHandle < invoiceItems.Count)
                {
                    var removed = invoiceItems[selectedRowHandle];
                    var product = allProducts.FirstOrDefault(p => p.Name == removed.ProductName);
                    if (product != null && !filteredProducts.Any(p => p.Id == product.Id))
                        filteredProducts.Add(product);
                    invoiceItems.RemoveAt(selectedRowHandle);
                    ApplyProductFilters(); // Ensure product grid is filtered after remove
                    RefreshProductGrid();
                    RefreshInvoiceGrid();
                    CalculateTotals();
                }
            }
        }

