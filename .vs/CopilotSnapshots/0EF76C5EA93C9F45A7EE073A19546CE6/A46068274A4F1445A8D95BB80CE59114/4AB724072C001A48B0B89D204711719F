        // Discount validation handler (must be inside class)
        private void TextEdit3_EditValueChanging(object sender, DevExpress.XtraEditors.Controls.ChangingEventArgs e)
        {
            if (isUpdatingDiscount) return;
            string newText = e.NewValue?.ToString() ?? "";
            if (string.IsNullOrWhiteSpace(newText))
            {
                discountExceededNotified = false;
                return;
            }
            string numeric = "";
            bool hasDot = false;
            foreach (char c in newText)
            {
                if (char.IsDigit(c)) numeric += c;
                else if (c == '.' && !hasDot) { numeric += c; hasDot = true; }
            }
            if (!decimal.TryParse(numeric, out decimal val))
                return;
            decimal total = invoiceItems.Sum(i => i.UnitPrice * i.Quantity);
            if (total > 0 && val > total)
            {
                e.Cancel = true;
                isUpdatingDiscount = true;
                textEdit3.Text = "";
                textEdit3.EditValue = null;
                isUpdatingDiscount = false;
                CalculateTotals();
                if (!discountExceededNotified)
                {
                    discountExceededNotified = true;
                    XtraMessageBox.Show($"قيمة الخصم لا يمكن أن تكون أكبر من إجمالي الفاتورة ({total:N0}).\nتم مسح قيمة الخصم.",
                        "خطأ في قيمة الخصم", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
            }
            else
            {
                discountExceededNotified = false;
            }
        }

        // Prevent typing non-numeric chars in discount
        private void TextEdit3_KeyPress(object sender, KeyPressEventArgs e)
        {
            // Only allow digits and control keys (backspace, delete)
            if (!char.IsControl(e.KeyChar) && !char.IsDigit(e.KeyChar))
            {
                e.Handled = true;
            }
        }

        private void TextEdit3_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.KeyCode == Keys.Enter)
            {
                if (isUpdatingDiscount) return;
                ValidateDiscountInput(textEdit3);
                e.Handled = true;
                e.SuppressKeyPress = true;
            }
        }

        private void ValidateDiscountInput(DevExpress.XtraEditors.TextEdit textEdit)
        {
            if (textEdit == null || isUpdatingDiscount) return;
            string text = textEdit.Text;
            if (string.IsNullOrWhiteSpace(text))
            {
                discountExceededNotified = false;
                CalculateTotals();
                return;
            }
            string numericText = "";
            bool hasDecimal = false;
            foreach (char c in text)
            {
                if (char.IsDigit(c)) numericText += c;
                else if (c == '.' && !hasDecimal)
                {
                    numericText += c;
                    hasDecimal = true;
                }
            }
            if (numericText != text)
            {
                isUpdatingDiscount = true;
                int cursorPosition = textEdit.SelectionStart;
                textEdit.Text = numericText;
                textEdit.EditValue = numericText;
                textEdit.SelectionStart = Math.Min(cursorPosition, textEdit.Text.Length);
                isUpdatingDiscount = false;
                CalculateTotals();
                return;
            }
            if (decimal.TryParse(numericText, out decimal value))
            {
                if (value < 0)
                {
                    isUpdatingDiscount = true;
                    textEdit.Text = "0";
                    textEdit.EditValue = "0";
                    isUpdatingDiscount = false;
                    discountExceededNotified = false;
                    CalculateTotals();
                    return;
                }
                decimal total = invoiceItems.Sum(i => i.UnitPrice * i.Quantity);
                if (total > 0 && value > total)
                {
                    isUpdatingDiscount = true;
                    textEdit.Text = "";
                    textEdit.EditValue = null;
                    textEdit.SelectionStart = 0;
                    isUpdatingDiscount = false;
                    CalculateTotals();
                    if (!discountExceededNotified)
                    {
                        discountExceededNotified = true;
                        XtraMessageBox.Show($"قيمة الخصم لا يمكن أن تكون أكبر من إجمالي الفاتورة ({total:N0}).\nتم مسح قيمة الخصم.",
                            "خطأ في قيمة الخصم", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    }
                    return;
                }
                discountExceededNotified = false;
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(text))
                {
                    isUpdatingDiscount = true;
                    textEdit.Text = "";
                    textEdit.EditValue = null;
                    isUpdatingDiscount = false;
                }
                discountExceededNotified = false;
                CalculateTotals();
            }
            CalculateTotals();
        }

        private void LoadAllProducts()
        {
            try
            {
                allProducts = dbContext.Products.Include("Prices").ToList();
                var prop = typeof(Product).GetProperty("IsDeleted");
                // If IsDeleted property exists, filter out deleted products
                if (prop != null)
                {
                    allProducts = allProducts.Where(p => !(bool)prop.GetValue(p)).ToList();
                }
                filteredProducts = new List<Product>(allProducts);
                RefreshProductGrid();
            }
            catch (Exception ex)
            {
                // Handle or log error as needed
            }
        }

        private void RefreshProductGrid()
        {
            var productList = filteredProducts.Select(p => new
            {
                p.Id,
                p.Name,
                Price = p.Prices.FirstOrDefault(pr => pr.IsActive == true) != null ?
                    p.Prices.Where(pr => pr.IsActive == true).OrderByDescending(pr => pr.CreatedDate).FirstOrDefault().SellingPrice : 0
            }).ToList();
            ProductGrid.DataSource = productList;
        }

        private void ApplyProductFilters()
        {
            string search = ProductSearch.Text.Trim();
            int? companyId = cmbCompany.EditValue as int?;
            int? categoryId = cmbCategory.EditValue as int?;
            filteredProducts = allProducts.Where(p =>
                (string.IsNullOrEmpty(search) || p.Name.Contains(search)) &&
                (!companyId.HasValue || p.CompanyId == companyId) &&
                (!categoryId.HasValue || p.CategoryId == categoryId)
            ).ToList();
            // Remove products already in invoice
            foreach (var inv in invoiceItems)
                filteredProducts.RemoveAll(p => p.Name == inv.ProductName);
        }

