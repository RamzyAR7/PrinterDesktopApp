        private void BtnAddItem_Click(object sender, EventArgs e)
        {
            if (selectedProduct == null) return;
            int quantity = (int)spinQuantity.Value;
            var price = selectedProduct.Prices.FirstOrDefault(pr => pr.IsActive == true) != null ?
                selectedProduct.Prices.Where(pr => pr.IsActive == true).OrderByDescending(pr => pr.CreatedDate).FirstOrDefault().SellingPrice : 0;
            invoiceItems.Add(new InvoiceItem
            {
                ProductName = selectedProduct.Name,
                UnitPrice = price,
                Quantity = quantity
            });
            // Remove from filteredProducts
            filteredProducts.RemoveAll(p => p.Id == selectedProduct.Id);
            ApplyProductFilters(); // Ensure product grid is filtered after add
            RefreshProductGrid();
            RefreshInvoiceGrid();
            CalculateTotals();
            selectedProduct = null;
            labelControl1.Text = "";
        }

