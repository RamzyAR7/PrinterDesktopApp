                    }

                    RefreshGrid();
                    CalculateTotals();
                    ClearItemInputs();
                }
            }
            catch (Exception ex)
            {
                XtraMessageBox.Show($"خطأ في إضافة المنتج: {ex.Message}",
                    "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Error);
