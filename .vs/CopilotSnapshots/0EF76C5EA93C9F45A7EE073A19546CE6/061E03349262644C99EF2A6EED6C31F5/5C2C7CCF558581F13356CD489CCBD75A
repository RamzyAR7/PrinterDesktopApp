        private void ValidateNumericInput(TextBox textBox)
        {
            if (textBox == null) return;

            string text = textBox.Text;
            if (string.IsNullOrEmpty(text)) return;

            // Allow only numbers and decimal point
            if (!System.Text.RegularExpressions.Regex.IsMatch(text, @"^\d*\.?\d*$"))
            {
                // Remove the last character if it's not valid
                int selectionStart = textBox.SelectionStart;
                textBox.Text = text.Substring(0, text.Length - 1);
                textBox.SelectionStart = Math.max(0, selectionStart - 1);
            }
        }

