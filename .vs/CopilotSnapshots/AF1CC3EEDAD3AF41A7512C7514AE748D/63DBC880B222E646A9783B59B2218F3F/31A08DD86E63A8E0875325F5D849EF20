        private Size CalculateOptimalFormSize()
        {
            // Get screen working area
            var screen = Screen.FromControl(this);
            var workingArea = screen.WorkingArea;
            
            // Calculate content height needs with INCREASED grid height
            int baseHeight = 120; // Top margins and title
            int clientDataHeight = 104; // groupControlClientData height
            int addProductHeight = 100; // groupControlAddProduct height
            int bottomPanelHeight = 60; // panelControl2 height
            int gridExpandedHeight = 400; // INCREASED grid height for better visibility
            int totalsHeight = 55; // Layout control totals section
            int margins = 30; // Margins
            
            // Calculate content height with larger grid
            int optimalHeight = baseHeight + clientDataHeight + addProductHeight + 
                              gridExpandedHeight + totalsHeight + bottomPanelHeight + margins;
            
            // Use expanded sizing approach - prioritize larger grid
            if (workingArea.Height <= 600) // Very small screens
            {
                optimalHeight = Math.Min(optimalHeight, (int)(workingArea.Height * 0.95));
            }
            else if (workingArea.Height <= 768) // Small screens
            {
                optimalHeight = Math.Min(optimalHeight, (int)(workingArea.Height * 0.90));
            }
            else
            {
                // Use larger size for better grid visibility
                optimalHeight = Math.Min(optimalHeight, (int)(workingArea.Height * 0.85));
            }
            
            // Ensure minimum usable height with good grid space
            optimalHeight = Math.Max(optimalHeight, 650);
            
            // Calculate width
            int optimalWidth;
            if (workingArea.Width <= 1366)
            {
                optimalWidth = Math.min(1000, workingArea.Width - 100);
            }
            else
            {
                optimalWidth = 1200; // Wider for larger screens
            }
            
            return new Size(optimalWidth, optimalHeight);
        }

        private void AdjustLayoutForScreenSize()
        {
            var screen = Screen.FromControl(this);
            var workingArea = screen.WorkingArea;
            
            // Adjust grid height for EXPANDED view
            if (layoutControl1 != null && groupControl1 != null)
            {
                // Calculate available space for EXPANDED grid
                int availableHeight = this.ClientSize.Height;
                int usedHeight = groupControlClientData.Height + groupControlAddProduct.Height + 
                               panelControl2.Height + 140; // Margins
                
                // Use EXPANDED grid height for better visibility
                int gridAreaHeight = Math.Max(300, availableHeight - usedHeight);
                
                // Remove the maximum limit to allow larger grid
                // gridAreaHeight = Math.Min(gridAreaHeight, 300); // REMOVED this limit
                
                // Allow grid to expand up to a reasonable maximum
                gridAreaHeight = Math.Min(gridAreaHeight, 500);
                
                // Adjust layout control size
                layoutControl1.Height = gridAreaHeight;
                
                // Position layout control properly
                layoutControl1.Location = new Point(5, 
                    groupControlClientData.Bottom + groupControlAddProduct.Height + 5);
                
                // Adjust group control to fit
                groupControl1.Height = layoutControl1.Bottom + 10;
            }
        }

